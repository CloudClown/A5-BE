# Server Configuration
PORT=5000
NODE_ENV=production
API_PREFIX=/api/v1

# CORS Configuration (Change to your frontend domain)
CORS_ORIGIN=https://your-frontend-domain.com

# Database Configuration
DB_URL=mongodb+srv://your-mongodb-atlas-url

# JWT Configuration (Use strong secrets in production)
JWT_SECRET=your-strong-production-jwt-secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-strong-production-refresh-secret
JWT_REFRESH_EXPIRES=30d

# Bcrypt Configuration
BCRYPT_SALT_ROUND=10

# Wallet Configuration
INITIAL_BALANCE_CENTS=5000
MINIMUM_BALANCE=0
WITHDRAWAL_FEE_PERCENTAGE=1.5
TRANSFER_FEE_PERCENTAGE=1.0
CASH_OUT_FEE_PERCENTAGE=2.0
AGENT_COMMISSION_PERCENTAGE=1.0
DAILY_TRANSACTION_LIMIT=50000
MONTHLY_TRANSACTION_LIMIT=1000000

# Super Admin Configuration (Change these in production)
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=admin@your-domain.com
SUPER_ADMIN_PASSWORD=use-a-strong-password-here

# Google OAuth Configuration (Optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://your-api-domain.com/api/v1/auth/google/callback

# Session Configuration
EXPRESS_SESSION_SECRET=your-strong-production-session-secret
SESSION_MAX_AGE=86400000 # 24 hours in milliseconds

# Frontend Configuration (Change to your frontend domain)
FRONTEND_URL=https://your-frontend-domain.com
FRONTEND_RESET_PASSWORD_URL=/reset-password
FRONTEND_EMAIL_VERIFY_URL=/verify-email

# Logging Configuration (Production settings)
LOG_LEVEL=error
ENABLE_REQUEST_LOGGING=false